<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Panda Profit"
    Language="1033"
    Version="1.0.0.0"
    Manufacturer="The Trashed Panda"
    UpgradeCode="FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perMachine"
      Description="A PandaSuite Application by The Trashed Panda" />

    <Media Id="1" Cabinet="Panda Profit.cab" EmbedCab="yes" />

    <Icon Id="icon.ico" SourceFile="$(var.SourceDir)\Panda Profit.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      AllowDowngrades="no" />

    <InstallScope="perMachine" />
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="PandaSuite">
        <Directory Id="APPFOLDER" Name="Panda Profit" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" Name="Desktop" />

    <StandardDirectory Id="ProgramMenuFolder" Name="Programs">
      <Directory Id="MENUDIR" Name="PandaSuite" />
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="Panda Profit" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RegistryEntries" />
    </Feature>

    <DirectoryRef Id="APPFOLDER">
      <Component Id="MainExecutable" Guid="00000000-0000-0000-0000-000000000000">
        <File
          Id="PandaProfitEXE"
          Source="$(var.SourceDir)\Panda Profit.exe"
          KeyPath="yes"
          Checksum="yes" />
        <File Id="IconFile" Source="$(var.SourceDir)\Panda Profit.ico" />
        <File Id="ConfigFile" Source="$(var.SourceDir)\config.json" />
        <File Id="PandaSuiteApiFile" Source="$(var.SourceDir)\panda_suite_api.py" />
        <!-- SQLite database will be created in %appdata%\PandaSuite\panda-profit\ -->
        <!-- Add other required files here -->

        <RegistryKey Root="HKLM" Key="Software\The Trashed Panda\Panda Profit" ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Name="InstallPath" Value="[APPFOLDER]" />
          <RegistryValue Type="string" Name="Version" Value="1.0.0" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="11111111-1111-1111-1111-111111111111">
        <Shortcut
          Id="DesktopShortcut"
          Name="Panda Profit"
          Target="[APPFOLDER]Panda Profit.exe"
          Icon="icon.ico"
          IconIndex="0"
          WorkingDirectory="APPFOLDER" />
        <RemoveFolder Id="DesktopFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\The Trashed Panda\Panda Profit"
          Name="DesktopShortcut"
          Value="1"
          Type="integer" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="MENUDIR">
      <Component Id="StartMenuShortcut" Guid="22222222-2222-2222-2222-222222222222">
        <Shortcut
          Id="StartMenuShortcut"
          Name="Panda Profit"
          Target="[APPFOLDER]Panda Profit.exe"
          Icon="icon.ico"
          WorkingDirectory="APPFOLDER" />
        <RemoveFolder Id="MENUDIR" On="uninstall" />
        <RemoveFolder Id="ProgramMenuFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\The Trashed Panda\Panda Profit"
          Name="StartMenuShortcut"
          Value="1"
          Type="integer" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="APPFOLDER">
      <Component Id="RegistryEntries" Guid="33333333-3333-3333-3333-333333333333">
        <RegistryKey Root="HKCU" Key="Software\The Trashed Panda\Panda Profit" ForceCreateOnInstall="yes">
          <RegistryValue Type="string" Name="AppName" Value="Panda Profit" />
          <RegistryValue Type="string" Name="Version" Value="1.0.0" />
          <RegistryValue Type="string" Name="PandaSuite" Value="yes" />
          <RegistryValue Type="string" Name="DatabasePath" Value="%appdata%\PandaSuite\panda-profit\database.db" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" Overridable="yes" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" Overridable="yes" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" Overridable="yes" />

  </Product>
</Wix>
