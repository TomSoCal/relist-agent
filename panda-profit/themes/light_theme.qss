/* Panda Profit - Light Theme */
/* Current branding colors, light mode */

QMainWindow, QWidget {
    background-color: #f5f5f5;
    color: #333333;
}

QTabWidget::pane {
    border: 1px solid #cccccc;
}

QTabBar::tab {
    background-color: #e8e8e8;
    color: #333333;
    padding: 5px 15px;
    border: 1px solid #cccccc;
}

QTabBar::tab:selected {
    background-color: #1F3864;
    color: #ffffff;
}

QPushButton {
    background-color: #1F3864;
    color: #ffffff;
    border: none;
    padding: 5px 15px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2a4a8a;
}

QPushButton:pressed {
    background-color: #153050;
}

QPushButton[text="Bulk Actions"] {
    background-color: #4a90e2;
}

QPushButton[text="Bulk Actions"]:hover {
    background-color: #6aa5ff;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 5px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #1F3864;
}

QLabel {
    color: #333333;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f5f5f5;
    border: none;
    gridline-color: #e8e8e8;
}

QTableWidget::item {
    padding: 5px;
    border: none;
    background-color: #ffffff;
}

QTableWidget::item:alternate {
    background-color: #f5f5f5;
}

QTableWidget::item:selected {
    background-color: #ffff99;
    color: #000000;
}

QHeaderView {
    background-color: #1F3864 !important;
    border: none;
}

QHeaderView::section {
    background-color: #1F3864 !important;
    color: #ffffff !important;
    padding: 5px;
    border: none;
    border-right: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
    font-weight: bold;
}

/* Corner button (top-left) */
QTableWidget::cornerButton {
    background-color: #1F3864 !important;
    border: none;
}

/* Row and column headers */
QHeaderView::section:horizontal {
    background-color: #1F3864 !important;
    color: #ffffff;
    padding: 5px;
    border: none;
    border-right: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
}

QHeaderView::section:vertical {
    background-color: #1F3864 !important;
    color: #ffffff;
    padding: 5px;
    border: none;
    border-right: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
}

QScrollBar:vertical {
    background-color: #f5f5f5;
    border: 1px solid #cccccc;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #999999;
}

QDialog {
    background-color: #f5f5f5;
}

/* Status indicators */
QLabel[text*="✓"], QLabel[text*="●"] {
    color: #90EE90;
}

QMessageBox {
    background-color: #f5f5f5;
}

QMessageBox QLabel {
    color: #333333;
}

QMessageBox QPushButton {
    min-width: 60px;
}

/* Radio buttons and checkboxes */
QRadioButton {
    color: #333333;
    spacing: 5px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cccccc;
    background-color: #ffffff;
    border-radius: 8px;
}

QRadioButton::indicator:checked {
    background-color: #1F3864;
    border: 1px solid #1F3864;
}

QRadioButton::indicator:hover {
    border: 2px solid #1F3864;
}

QCheckBox {
    color: #333333;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cccccc;
    background-color: #ffffff;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #1F3864;
    border: 1px solid #1F3864;
}

QCheckBox::indicator:hover {
    border: 2px solid #1F3864;
}
